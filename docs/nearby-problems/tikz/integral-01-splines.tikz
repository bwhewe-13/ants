\begin{tikzpicture}

% Highlight cell
\filldraw[fill=red!20, draw=black, text opacity=1] (0,0) rectangle (5,5);

% Grid
\draw[step=5.0, black] (0, 0) grid (8, 8);
\draw[step=5.0, black, dotted, xshift=-2.5cm, yshift=-2.5cm, very thick] (5, 5) grid +(5, 5);

% Add points - cell edges
\foreach\i in {0,5} \foreach\j in {0,5}{
    \node[circle,draw,fill=black,minimum size=5pt, inner sep=0pt] at (\i,\j){};
}

% Add points - knots
\foreach\i in {2.5,7.5} \foreach\j in {2.5,7.5}{
    \node at (\i, \j) {$\star$};
}

% Add labels - knots
\node[above right] at (2.5, 2.5) {\small ($x_{i}, y_{j}$)};
\node[below right] at (2.5, 7.5) {\small ($x_{i}, y_{j+1}$)};
\node[above left] at (7.5, 2.5) {\small ($x_{i+1}, y_{j}$)};
\node[below left] at (7.5, 7.5) {\small ($x_{i+1}, y_{j+1}$)};

% Add labels - cell edges
\node[below right] at (0, 0) {\small ($x_{i-1/2}, y_{j-1/2}$)};
\node[below right] at (0, 5) {\small ($x_{i-1/2}, y_{j+1/2}$)};
\node[above left] at (5, 0) {\small ($x_{i+1/2}, y_{j-1/2}$)};
\node[above left] at (5, 5) {\small ($x_{i+1/2}, y_{j+1/2}$)};

% Add labels - lines
\draw[->,thick] (1.375, 6) node (knot) [below] {\small Spline Knot} -- (2.4, 7.4);
\draw[->,thick] (6.5, 1.5) node (edge) [above] {\small Spatial Cell Edge} -- (5.1, 0.1);
\draw [decorate,decoration={brace,amplitude=10pt,raise=2ex}]
  (2.5, 7.5) -- (7.5, 7.5) node[midway,yshift=2.5em]{Spline $S_{i,j}(x, y)$};

\end{tikzpicture}
